<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rhema's dark palette (#215): ink and slate, deep teal accent, no violet. -->
    <color name="ink">#FF121C22</color>
    <color name="card">#FF1A262E</color>
    <color name="teal">#FF256D68</color>
    <color name="teal_text">#FF5FB3A8</color>
    <!-- Behind the launcher mark: white, so the black rounded square reads whole in any mask. -->
    <color name="launcher_background">#FFFFFFFF</color>
    <style name="Viewfinder" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/teal_text</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="Settings" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/card</item>
        <item name="android:colorPrimaryDark">@color/ink</item>
        <item name="android:colorAccent">@color/teal_text</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
