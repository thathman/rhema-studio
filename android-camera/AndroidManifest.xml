<?xml version="1.0" encoding="utf-8"?>
<!-- Rhema Studio Cam (#209, formerly Rhema Camera): a phone's camera, sent to Rhema Studio's camera router over the
     church network. Developer: Airix Media — Hendrix Nwaokolo. From 1.7.0.0 the package is com.airixmedia.rhema.camera;
     earlier builds (com.openbezal.rhema.camera) are a separate app: pair once, then uninstall the old one. The
     rhema-camera:// link stays. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.airixmedia.rhema.camera"
    android:versionCode="8"
    android:versionName="1.7.0.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Send again after the phone restarts, when it was sending (#836). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- No backup: the pairing link holds this camera's password. -->
    <!-- The earlier build under the old package (before the Airix Media name): found, so it can be removed. -->
    <queries>
        <package android:name="com.openbezal.rhema.camera" />
    </queries>

    <application
        android:label="Rhema Studio Cam"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Settings">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Viewfinder"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing links from Rhema's Cameras card, opened from the phone's QR scanner or a message. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rhema-camera" android:host="pair" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Settings" />
        <service
            android:name=".CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
        <!-- After a restart or an update: send again (Android 10 and older) or ask with a notification (#836). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
