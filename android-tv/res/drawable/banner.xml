<?xml version="1.0" encoding="utf-8"?>
<!-- The TV launcher's 16:9 banner: the Rhema mark on black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111111" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="center" android:drawable="@drawable/icon" />
</layer-list>
